# Configuration inventory. The exported flow DOES NOT automatically load this file.
# Set these values privately in Langflow component fields or global variables.
GOOGLE_API_KEY=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=default_keyspace
ASTRA_COLLECTION_ENGINEERING=Engineering
ASTRA_COLLECTION_FINANCE=Finance
