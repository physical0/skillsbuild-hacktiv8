# Model from the source export. Verify availability for your account before running.
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
# Only needed for optional Bob/MCP integration. Copy the actual URL from Langflow.
LANGFLOW_SERVER_URL=http://127.0.0.1:7860
LANGFLOW_PROJECT_ID=
LANGFLOW_API_KEY=
